+TEST_F(GXFifoTest, Viewport_RetailRawOriginUses342) {
+  // Independent retail FIFO values, not an encoder/decoder round trip.
+  std::vector<u8> bytes{0x10, 0x00, 0x05, 0x10, 0x1a};
+  for (float value : {320.0f, -224.0f, 16777215.0f, 662.0f, 566.0f, 16777215.0f}) {
+    const u32 word = std::bit_cast<u32>(value);
+    bytes.push_back(word >> 24);
+    bytes.push_back(word >> 16);
+    bytes.push_back(word >> 8);
+    bytes.push_back(word);
+  }
+  reset_gx_state();
+  decode_fifo(bytes);
+  EXPECT_FLOAT_EQ(g_gxState.logicalViewport.left, 0.0f);
+  EXPECT_FLOAT_EQ(g_gxState.logicalViewport.top, 0.0f);
+  EXPECT_FLOAT_EQ(g_gxState.logicalViewport.width, 640.0f);
+  EXPECT_FLOAT_EQ(g_gxState.logicalViewport.height, 448.0f);
+}
