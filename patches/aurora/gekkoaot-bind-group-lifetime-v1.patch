+TEST(BindGroupCacheLifetime, RetainsReferencesFromQueuedFrames) {
+  using aurora::gfx::detail::bind_group_cache_expired;
+  EXPECT_FALSE(bind_group_cache_expired(100, 101));
+  EXPECT_FALSE(bind_group_cache_expired(100, 100));
+  EXPECT_FALSE(bind_group_cache_expired(100, 68));
+  EXPECT_FALSE(bind_group_cache_expired(100, 70));
+  EXPECT_TRUE(bind_group_cache_expired(100, 67));
+  EXPECT_FALSE(bind_group_cache_expired(0, UINT32_MAX));
+  EXPECT_TRUE(bind_group_cache_expired(1, UINT32_MAX - 32));
+}
