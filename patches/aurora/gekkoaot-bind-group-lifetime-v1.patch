diff --git a/lib/gfx/resource_cache_lifetime.hpp b/lib/gfx/resource_cache_lifetime.hpp
new file mode 100644
index 0000000..d061ff7
--- /dev/null
+++ b/lib/gfx/resource_cache_lifetime.hpp
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <cstdint>
+
+namespace aurora::gfx::detail {
+
+inline constexpr bool bind_group_cache_expired(std::uint32_t completedFrame,
+                                               std::uint32_t lastUsedFrame) noexcept {
+  // A bind group referenced by an already recorded but not yet submitted frame
+  // has a lastUsedFrame later than completedFrame. Signed modular age keeps it
+  // alive, including when the 32-bit frame counter wraps.
+  const auto age = completedFrame - lastUsedFrame;
+  return age > 32u && age < 0x80000000u;
+}
+
+} // namespace aurora::gfx::detail
