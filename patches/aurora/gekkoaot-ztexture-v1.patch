+// Z texture bias/control (0xF4/0xF5). The PE consumes the raw texture input of
+// the last TEV stage and turns it into an 8/16/24-bit depth value.
+void bp_ztex_bias(u8, u32 value) noexcept { g_gxState.zTexBias = value & 0x00FFFFFFu; }
+
+void bp_ztex_control(u8, u32 value) noexcept {
+  g_gxState.zTexType = reg_get(value, 2, 0);
+  const u32 op = reg_get(value, 2, 2);
+  g_gxState.zTexOp = op <= GX_ZT_REPLACE ? static_cast<GXZTexOp>(op) : GX_ZT_DISABLE;
+}
