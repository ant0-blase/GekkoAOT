+TEST_F(GxTextureCacheTest, SameObjectVersionReinterpretsDimensionsFormatAndMips) {
+  std::array<uint8_t, 256> pixels{};
+  auto obj = make_texture(pixels.data(), 1, GX_TF_I4, 8, 8);
+  const auto first = texture::resolve_static_texture(obj);
+  obj.mWidth = 16;
+  const auto wider = texture::resolve_static_texture(obj);
+  EXPECT_NE(first, wider);
+  obj.mFormat = GX_TF_I8;
+  const auto reformatted = texture::resolve_static_texture(obj);
+  EXPECT_NE(wider, reformatted);
+  obj.flags |= 1;
+  obj.mode1 = 16 << 8;
+  EXPECT_NE(reformatted, texture::resolve_static_texture(obj));
+  EXPECT_EQ(testing::texture_allocations(), 4);
+}
+
+TEST_F(GxTextureCacheTest, DirtyBindingReinterpretsSameObjectAndPalette) {
+  std::array<uint8_t, 128> indices{};
+  std::array<uint8_t, 512> palette{};
+  g_gxState.loadedTextures[0] = make_texture(indices.data(), 1, GX_TF_C4, 8, 8);
+  g_gxState.loadedTluts[0] = make_tlut(palette.data(), 1);
+  ShaderInfo info{};
+  info.sampledTextures.set(0);
+  resolve_sampled_textures(info);
+  const auto first = g_gxState.textures[0].ref;
+  g_gxState.loadedTextures[0].mWidth = 16;
+  resolve_sampled_textures(info);
+  const auto wider = g_gxState.textures[0].ref;
+  EXPECT_NE(first, wider);
+  g_gxState.loadedTluts[0].format = GX_TL_IA8;
+  resolve_sampled_textures(info);
+  EXPECT_NE(wider, g_gxState.textures[0].ref);
+  const auto ia8 = g_gxState.textures[0].ref;
+  g_gxState.loadedTluts[0].numEntries = 256;
+  resolve_sampled_textures(info);
+  EXPECT_NE(ia8, g_gxState.textures[0].ref);
+  EXPECT_EQ(testing::texture_allocations(), 4);
+}
