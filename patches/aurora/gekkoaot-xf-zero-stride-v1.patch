diff --git a/tests/gx_fifo_test.cpp b/tests/gx_fifo_test.cpp
--- a/tests/gx_fifo_test.cpp
+++ b/tests/gx_fifo_test.cpp
@@ -2031,6 +2031,38 @@
 
 // --- GXLoadPosMtxIndx (indexed XF load from GX_POS_MTX_ARRAY) ---
 
+TEST_F(GXFifoTest, LoadPosMtxIndx_ZeroStrideReusesSingleMatrix) {
+  aurora::Mat3x4<float> source{};
+  source.m0 = {1.0f, 2.0f, 3.0f, 4.0f};
+  source.m1 = {5.0f, 6.0f, 7.0f, 8.0f};
+  source.m2 = {9.0f, 10.0f, 11.0f, 12.0f};
+
+  // GXSetArray's address calculation is base + index * stride. A zero
+  // stride selects this one matrix for every index, including index 65535.
+  GXSetArray(GX_POS_MTX_ARRAY, &source, sizeof(source), 0, true);
+  GXLoadPosMtxIndx(7, GX_PNMTX0);
+  GXLoadPosMtxIndx(0xffff, GX_PNMTX1);
+  const auto bytes = capture_fifo();
+
+  reset_gx_state();
+  decode_fifo(bytes);
+  EXPECT_EQ(g_gxState.pnMtx[0].pos, source);
+  EXPECT_EQ(g_gxState.pnMtx[1].pos, source);
+}
+
+TEST_F(GXFifoTest, LoadPosMtxIndx_ZeroStrideStillChecksSourceLength) {
+  aurora::Mat3x4<float> source{};
+  source.m0 = {1.0f, 2.0f, 3.0f, 4.0f};
+  GXSetArray(GX_POS_MTX_ARRAY, &source, sizeof(source) - 1, 0, true);
+  GXLoadPosMtxIndx(7, GX_PNMTX0);
+  const auto bytes = capture_fifo();
+
+  reset_gx_state();
+  const auto before = g_gxState.pnMtx[0].pos;
+  decode_fifo(bytes);
+  EXPECT_EQ(g_gxState.pnMtx[0].pos, before);
+}
+
