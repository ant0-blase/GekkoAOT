+struct DrawRangeDiagnostics {
+  const bool enabled = [] {
+    const char* value = std::getenv("GEKKOAOT_GX_DIAG_DRAW_RANGES");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+  }();
+  std::atomic<uint64_t> generated{0};
+  std::atomic<uint64_t> submitted{0};
+  std::atomic<uint64_t> anomalies{0};
+  std::atomic<uint64_t> indexCountOverflow{0};
+  std::atomic<uint64_t> vertexIndexOverflow{0};
+  std::atomic<uint64_t> partialQuads{0};
+  std::atomic<uint64_t> drawRangeOverflow{0};
+
+  ~DrawRangeDiagnostics() {
+    if (enabled) {
+      std::fprintf(stderr,
+                   "GEKKOAOT_GX_DIAG_DRAW_RANGES summary submitted=%llu generated=%llu anomalies=%llu "
+                   "index_count_overflow=%llu vertex_index_overflow=%llu partial_quads=%llu draw_range_overflow=%llu\n",
+                   static_cast<unsigned long long>(submitted.load()),
+                   static_cast<unsigned long long>(generated.load()),
+                   static_cast<unsigned long long>(anomalies.load()),
+                   static_cast<unsigned long long>(indexCountOverflow.load()),
+                   static_cast<unsigned long long>(vertexIndexOverflow.load()),
+                   static_cast<unsigned long long>(partialQuads.load()),
+                   static_cast<unsigned long long>(drawRangeOverflow.load()));
+    }
+  }
+};
+
+DrawRangeDiagnostics g_drawRangeDiagnostics;
+
+void diagnose_draw_ranges(gfx::Range verts, gfx::Range indices, uint32_t vtxCount,
+                          uint32_t indexCount, uint32_t vtxStride) {
+  if (!g_drawRangeDiagnostics.enabled) return;
+  const uint64_t submitted = g_drawRangeDiagnostics.submitted.fetch_add(1) + 1;
+  const bool overflow = static_cast<uint64_t>(verts.offset) + verts.size > gfx::VertexBufferSize ||
+                        static_cast<uint64_t>(indices.offset) + indices.size > gfx::IndexBufferSize ||
+                        static_cast<uint64_t>(vtxCount) * vtxStride > verts.size ||
+                        (indexCount != 0 && indexCount > indices.size / sizeof(u16));
+  if (overflow) {
+    g_drawRangeDiagnostics.drawRangeOverflow.fetch_add(1);
+    const uint64_t event = g_drawRangeDiagnostics.anomalies.fetch_add(1) + 1;
+    if (event <= 3) {
+      std::fprintf(stderr,
+                   "GEKKOAOT_GX_DIAG_DRAW_RANGES event=%llu vtx=%u stride=%u vert=%u+%u "
+                   "indices=%u idx=%u+%u\n",
+                   static_cast<unsigned long long>(event), vtxCount, vtxStride,
+                   verts.offset, verts.size, indexCount, indices.offset, indices.size);
+    }
+  }
+  if (submitted == 100 || submitted == 1000 || submitted == 10000 || submitted == 100000 ||
+      submitted == 1000000 || submitted == 10000000) {
+    std::fprintf(stderr,
+                 "GEKKOAOT_GX_DIAG_DRAW_RANGES checkpoint submitted=%llu anomalies=%llu "
+                 "draw_range_overflow=%llu index_count_overflow=%llu vertex_index_overflow=%llu partial_quads=%llu\n",
+                 static_cast<unsigned long long>(submitted),
+                 static_cast<unsigned long long>(g_drawRangeDiagnostics.anomalies.load()),
+                 static_cast<unsigned long long>(g_drawRangeDiagnostics.drawRangeOverflow.load()),
+                 static_cast<unsigned long long>(g_drawRangeDiagnostics.indexCountOverflow.load()),
+                 static_cast<unsigned long long>(g_drawRangeDiagnostics.vertexIndexOverflow.load()),
+                 static_cast<unsigned long long>(g_drawRangeDiagnostics.partialQuads.load()));
+  }
+}
