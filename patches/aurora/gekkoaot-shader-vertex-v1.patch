diff --git a/tests/nbt3_shader_test.cpp b/tests/nbt3_shader_test.cpp
new file mode 100644
index 0000000..fd93781
--- /dev/null
+++ b/tests/nbt3_shader_test.cpp
@@ -0,0 +1,79 @@
+#include <gtest/gtest.h>
+
+#include "gx/gx.hpp"
+
+#include <string>
+#include <string_view>
+
+namespace aurora::gx {
+namespace {
+
+std::string nbt_slice_line(GXTexGenSrc source) {
+  ShaderConfig config{};
+  config.vtxStride = 15;
+  config.attrs[GX_VA_POS] = {
+      .attrType = GX_DIRECT, .cnt = 3, .compType = GX_F32, .offset = 0};
+  config.attrs[GX_VA_NRM] = {
+      .attrType = GX_INDEX8, .cnt = 9, .compType = GX_S16,
+      .offset = 12, .stride = 6, .le = false, .nbt3 = true};
+  config.tevStageCount = 1;
+  auto& stage = config.tevStages[0];
+  stage.colorPass.d = GX_CC_TEXC;
+  stage.texCoordId = GX_TEXCOORD0;
+  stage.texMapId = GX_TEXMAP0;
+  config.tcgs[0].src = source;
+
+  const std::string shader = build_shader_source(config);
+  const std::string_view declaration = source == GX_TG_BINRM ? "let in_binrm = " : "let in_tangent = ";
+  const auto start = shader.find(declaration);
+  if (start == std::string::npos) return {};
+  const auto end = shader.find(';', start);
+  if (end == std::string::npos) return {};
+  return shader.substr(start, end - start);
+}
+
+TEST(GxShaderTest, Nbt3BinormalIndexSelectsOneXyzElement) {
+  const auto line = nbt_slice_line(GX_TG_BINRM);
+  ASSERT_FALSE(line.empty());
+  // The second independent index is at vertex offset 13. It selects one
+  // six-byte XYZ vector; there is no additional B offset after that lookup.
+  EXPECT_NE(line.find("+ 13u) * 6u + 0u"), std::string::npos) << line;
+}
+
+TEST(GxShaderTest, Nbt3TangentIndexSelectsOneXyzElement) {
+  const auto line = nbt_slice_line(GX_TG_TANGENT);
+  ASSERT_FALSE(line.empty());
+  // The third independent index is at vertex offset 14.
+  EXPECT_NE(line.find("+ 14u) * 6u + 0u"), std::string::npos) << line;
+}
+
+TEST(GxShaderTest, DynamicTextureMatrixIdentityDoesNotIndexPastUniformArray) {
+  ShaderConfig config{};
+  config.vtxStride = 21;
+  config.attrs[GX_VA_POS] = {.attrType = GX_DIRECT, .cnt = 3, .compType = GX_F32, .offset = 0};
+  config.attrs[GX_VA_TEX0MTXIDX] = {.attrType = GX_DIRECT, .cnt = 1, .compType = GX_U8, .offset = 12};
+  config.attrs[GX_VA_TEX0] = {.attrType = GX_DIRECT, .cnt = 2, .compType = GX_F32, .offset = 13};
+  config.tevStageCount = 1;
+  auto& stage = config.tevStages[0];
+  stage.colorPass.d = GX_CC_TEXC;
+  stage.texCoordId = GX_TEXCOORD0;
+  stage.texMapId = GX_TEXMAP0;
+  config.tcgs[0].src = GX_TG_TEX0;
+  config.tcgs[0].mtx = GX_TEXMTX0;
+
+  const std::string shader = build_shader_source(config);
+  const auto identity = shader.find("var tc0_tmp = tc0.xyz;");
+  const auto guard = shader.find("if (in_texmtxidx0 < 60u) {", identity);
+  const auto lookup = shader.find("tc0_tmp = tc0 * ubuf.postex_mtx[in_texmtxidx0 / 3u];", guard);
+  const auto endGuard = shader.find('}', guard);
+  ASSERT_NE(identity, std::string::npos);
+  ASSERT_NE(guard, std::string::npos);
+  ASSERT_NE(lookup, std::string::npos);
+  ASSERT_NE(endGuard, std::string::npos);
+  EXPECT_LT(identity, guard);
+  EXPECT_LT(guard, lookup);
+  EXPECT_LT(lookup, endGuard);
+}
+
+} // namespace
+} // namespace aurora::gx
