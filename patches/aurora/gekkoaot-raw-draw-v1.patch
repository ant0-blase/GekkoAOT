+bool submit_raw_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vertexCount,
+                     const u8* vertexData, u32 vertexBytes) noexcept {
+  if (!vertexData || vertexCount == 0u) return false;
+  u32 vtxSize;
+  if (g_gxState.lastVtxFmt == fmt)
+    vtxSize = g_gxState.lastVtxSize;
+  else
+    vtxSize = calc_vtx_size(fmt);
+  if (vtxSize == 0u || static_cast<u64>(vertexCount) * vtxSize != vertexBytes)
+    return false;
+  ByteReader reader{{vertexData, vertexBytes}};
+  draw_prim(prim, fmt, vertexCount, reader);
+  return reader.empty();
+}
