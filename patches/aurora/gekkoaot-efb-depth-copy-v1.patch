@@ -472,8 +472,11 @@ static inline bool requires_load_conversion(const GXTexObj_& obj) {
 }
 static inline bool is_palette_format(u32 fmt) { return fmt == GX_TF_C4 || fmt == GX_TF_C8 || fmt == GX_TF_C14X2; }
 static inline bool is_depth_format(u32 fmt) {
+  // Raw EFB copy format 0xB is Z16R when PE is in depth-copy mode. GXEnum.h
+  // does not expose a GX_CTF_Z16R symbol, but its encoded GXTexFmt value is
+  // 0x0B | _GX_TF_ZTF | _GX_TF_CTF == 0x3B.
   return fmt == GX_TF_Z8 || fmt == GX_TF_Z16 || fmt == GX_TF_Z24X8 || fmt == GX_CTF_Z4 || fmt == GX_CTF_Z8M ||
-         fmt == GX_CTF_Z8L || fmt == GX_CTF_Z16L;
+         fmt == GX_CTF_Z8L || fmt == 0x3Bu || fmt == GX_CTF_Z16L;
 }
 
