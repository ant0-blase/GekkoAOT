+static int compare_u64(const void* left, const void* right) {
+    u64 a = *(const u64*)left;
+    u64 b = *(const u64*)right;
+    return a < b ? -1 : a > b;
+}
+
+static int partition_internal_labels_v275(void) {
+    const char* value = getenv("DOLRECOMP_PARTITION_INTERNAL_LABELS");
+    return value && value[0] && !(value[0] == '0' && value[1] == '\0');
+}
+
+static int sorted_u32_contains(const u32* values, u32 count, u32 value) {
+    u32 low = 0, high = count;
+    while (low < high) {
+        u32 middle = low + (high - low) / 2u;
+        if (values[middle] < value)
+            low = middle + 1u;
+        else
+            high = middle;
+    }
+    return low < count && values[low] == value;
+}
+
+/* Last strong point at or below address (or the section base if none). */
+static u32 strong_region_start(const u32* strong, u32 count, u32 address,
+                               u32 section_base) {
+    u32 low = 0, high = count;
+    while (low < high) {
+        u32 middle = low + (high - low) / 2u;
+        if (strong[middle] <= address)
+            low = middle + 1u;
+        else
+            high = middle;
+    }
+    u32 start = low ? strong[low - 1u] : section_base;
+    return start < section_base ? section_base : start;
+}
+
+/* edges: sorted (target << 32 | source) of forward non-linking branches. */
+static int reached_from_region(const u64* edges, size_t count, u32 label,
+                               u32 region) {
+    size_t low = 0, high = count;
+    const u64 first = (u64)label << 32;
+    while (low < high) {
+        size_t middle = low + (high - low) / 2u;
+        if (edges[middle] < first)
+            low = middle + 1u;
+        else
+            high = middle;
+    }
+    for (size_t i = low; i < count && (u32)(edges[i] >> 32) == label; i++) {
+        u32 source = (u32)edges[i];
+        if (source >= region && source < label)
+            return 1;
+    }
+    return 0;
+}
