+/* GekkoAOT v364: DOLRECOMP_REL_ALIGN (a power of two, 0x20..64 KiB) packs
+ * the batch at that alignment, ending each REL at its last section, so the
+ * caller's dense canonical layout (Twilight Princess: 757 RELs) stays within
+ * REL24 range of the DOL. Unset keeps the 64 KiB slots. */
+static u32 rel_dense_align(void) {
+    static int parsed = 0;
+    static u32 align = 0;
+    if (!parsed) {
+        const char* text = getenv("DOLRECOMP_REL_ALIGN");
+        parsed = 1;
+        if (text && *text) {
+            char* stop = NULL;
+            unsigned long value = strtoul(text, &stop, 0);
+            if (stop && *stop == 0 && value >= 0x20u && value <= REL_AUTO_ALIGN &&
+                (value & (value - 1u)) == 0)
+                align = (u32)value;
+            else
+                fprintf(stderr, "warning: ignoring DOLRECOMP_REL_ALIGN=%s\n", text);
+        }
+    }
+    return align;
+}
+
