+  // equals the architectural f64 one except when non-IEEE mode (MXCSR DAZ)
+  // zeroes an f32-denormal input. Operands not statically proven
+  // denormal-safe used to take the f64 path unconditionally (also in IEEE
+  // mode); select it at run time only for that case instead.
+  static const bool runtimeGate = [] {
+    const char *setting = std::getenv("DOLRECOMP_PAIRED_NI_DENORMAL");
+    return !setting || setting[0] != '0';
+  }();
+  auto gated = [&](std::initializer_list<u32> regs, auto &&path,
+                   FPValueClass valueClass) {
+    Type *integerPair = FixedVectorType::get(Type::getInt32Ty(context_), 2);
+    auto splat = [&](u32 value) {
+      return ConstantVector::getSplat(ElementCount::getFixed(2), builder_.getInt32(value));
+    };
+    Value *anyDenormal = builder_.getFalse();
+    for (u32 reg : regs) {
+      Value *bits = builder_.CreateBitCast(pairF32(reg), integerPair);
+      Value *denormal = builder_.CreateAnd(
+          builder_.CreateICmpEQ(builder_.CreateAnd(bits, splat(0x7F800000u)), splat(0u)),
+          builder_.CreateICmpNE(builder_.CreateAnd(bits, splat(0x007FFFFFu)), splat(0u)));
+      anyDenormal = builder_.CreateOr(anyDenormal,
+          builder_.CreateOr(builder_.CreateExtractElement(denormal, uint64_t{0}),
+                            builder_.CreateExtractElement(denormal, 1u)));
+    }
+    Value *strict = builder_.CreateAnd(niEnabled(), anyDenormal, "ps.ni.denormal");
+    BasicBlock *single = BasicBlock::Create(context_, "ps_single", function_);
+    BasicBlock *wide = BasicBlock::Create(context_, "ps_architectural", function_);
+    BasicBlock *join = BasicBlock::Create(context_, "ps_precision_join", function_);
+    builder_.CreateCondBr(strict, wide, single, MDBuilder(context_).createBranchWeights(1, 2000));
+    builder_.SetInsertPoint(single);
+    Value *singleResult = roundPairToSingle(path(true));
+    builder_.CreateBr(join);
+    BasicBlock *singleEnd = builder_.GetInsertBlock();
+    builder_.SetInsertPoint(wide);
+    Value *wideResult = roundPairToSingle(path(false));
+    builder_.CreateBr(join);
+    BasicBlock *wideEnd = builder_.GetInsertBlock();
+    builder_.SetInsertPoint(join);
+    PHINode *rounded = builder_.CreatePHI(FixedVectorType::get(Type::getFloatTy(context_), 2), 2, "ps.precision");
+    rounded->addIncoming(singleResult, singleEnd);
+    rounded->addIncoming(wideResult, wideEnd);
+    writePairF32(d, rounded, true, valueClass);
+    updateFPRF(builder_.CreateExtractElement(rounded, uint64_t{0}));
+  };
 
