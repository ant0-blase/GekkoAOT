+/* GekkoAOT v395: an aligned branch whose synthetic placement is out of its
+ * displacement range keeps a zero displacement in the image; the decoder
+ * returns the recorded absolute target instead (decoder_far_branch). On the
+ * console the game's OSLink places the module within range, so only the AOT
+ * layout is affected. */
+static int far_rel_branch(s64 delta, s64 min, s64 max, u32 patch_address, u32 target) {
+    if ((delta & 3) != 0 || (delta >= min && delta <= max))
+        return 0;
+    decoder_add_far_branch(patch_address, target);
+    return 1;
+}
