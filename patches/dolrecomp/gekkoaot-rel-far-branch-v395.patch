diff --git a/src/frontend/decoder.c b/src/frontend/decoder.c
--- a/src/frontend/decoder.c
+++ b/src/frontend/decoder.c
@@ -2,6 +2,7 @@
 // Copyright (C) 2026 ExpansionPak
 
 #include "decoder.h"
+#include <stdlib.h>
 #include <stdio.h>
 #include <string.h>
 
@@ -25,6 +26,65 @@
 #define PPC_SIMM(raw)      ((s16)((raw) & 0xFFFF))
 #define PPC_UIMM(raw)      ((u16)((raw) & 0xFFFF))
 
+/* GekkoAOT v395: far REL branch targets (see decoder.h). Filled before the
+ * REL batch forks its workers, read-only afterwards. */
+static u32* g_far_keys;
+static u32* g_far_values;
+static size_t g_far_capacity;
+static size_t g_far_count;
+
+static size_t far_slot(u32 address, size_t capacity) {
+    return (size_t)((address >> 2) * 2654435761u) & (capacity - 1u);
+}
+
+void decoder_add_far_branch(u32 address, u32 target) {
+    if ((g_far_count + 1u) * 2u > g_far_capacity) {
+        size_t capacity = g_far_capacity ? g_far_capacity * 2u : 1024u;
+        u32* keys = (u32*)calloc(capacity, sizeof(u32));
+        u32* values = (u32*)calloc(capacity, sizeof(u32));
+        if (!keys || !values) {
+            free(keys);
+            free(values);
+            return;
+        }
+        for (size_t i = 0; i < g_far_capacity; i++) {
+            if (!g_far_keys[i])
+                continue;
+            size_t slot = far_slot(g_far_keys[i], capacity);
+            while (keys[slot])
+                slot = (slot + 1u) & (capacity - 1u);
+            keys[slot] = g_far_keys[i];
+            values[slot] = g_far_values[i];
+        }
+        free(g_far_keys);
+        free(g_far_values);
+        g_far_keys = keys;
+        g_far_values = values;
+        g_far_capacity = capacity;
+    }
+    size_t slot = far_slot(address, g_far_capacity);
+    while (g_far_keys[slot] && g_far_keys[slot] != address)
+        slot = (slot + 1u) & (g_far_capacity - 1u);
+    if (!g_far_keys[slot])
+        g_far_count++;
+    g_far_keys[slot] = address;
+    g_far_values[slot] = target;
+}
+
+int decoder_far_branch(u32 address, u32* target) {
+    if (!g_far_count || !address)
+        return 0;
+    size_t slot = far_slot(address, g_far_capacity);
+    while (g_far_keys[slot]) {
+        if (g_far_keys[slot] == address) {
+            *target = g_far_values[slot];
+            return 1;
+        }
+        slot = (slot + 1u) & (g_far_capacity - 1u);
+    }
+    return 0;
+}
+
 static void decode_d_rt_ra(PPCInst* inst, PPCOpcode op, u32 raw) {
     inst->op = op;
     inst->rD = PPC_RD(raw);
