 using namespace llvm;
 
+namespace {
+struct StaticInterceptTable {
+  bool enabled = false;
+  std::vector<u32> addresses;
+};
+
+const StaticInterceptTable& staticInterceptTable() {
+  // One immutable table per DolRecomp invocation. The manifest is generated by
+  // GekkoAOT's structural SDK resolver before the optimized AOT pass, so this
+  // is compiler input, not runtime game-specific logic.
+  static const StaticInterceptTable table = [] {
+    StaticInterceptTable result;
+    const char* path = std::getenv("DOLRECOMP_STATIC_INTERCEPTS");
+    if (!path || !*path)
+      return result;
+    std::ifstream in(path);
+    if (!in)
+      return result; // Fail safe: keep normal runtime admission probes.
+    result.enabled = true;
+    std::string line;
+    while (std::getline(in, line)) {
+      if (line.empty() || line[0] == '#')
+        continue;
+      char* end = nullptr;
+      const unsigned long value = std::strtoul(line.c_str(), &end, 0);
+      if (end == line.c_str() || value > 0xfffffffful)
+        return StaticInterceptTable{}; // Malformed input: preserve dynamic checks.
+      result.addresses.push_back(static_cast<u32>(value));
+    }
+    std::sort(result.addresses.begin(), result.addresses.end());
+    result.addresses.erase(std::unique(result.addresses.begin(), result.addresses.end()),
+                           result.addresses.end());
+    return result;
+  }();
+  return table;
+}
+
+bool regionNeedsInterception(u32 start, u32 end) {
+  const auto& table = staticInterceptTable();
+  if (!table.enabled || start >= end)
+    return true;
+  const auto it = std::lower_bound(table.addresses.begin(), table.addresses.end(), start);
+  return it != table.addresses.end() && *it < end;
+}
