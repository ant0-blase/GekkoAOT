+// architecture denormalizes, by truncation, for FRS[1:11] <= 896.
+u32 ppc_stfs_tiny(f64 value) {
+    u64 bits;
+    memcpy(&bits, &value, sizeof(bits));
+    const u32 sign = (u32)(bits >> 32) & 0x80000000u;
+    const u32 exponent = (u32)(bits >> 52) & 0x7FFu;
+    if (exponent - 874u > 22u)
+        return sign;
+    const u64 fraction = (bits & 0x000FFFFFFFFFFFFFull) | 0x0010000000000000ull;
+    return sign | (u32)(fraction >> (926u - exponent));
