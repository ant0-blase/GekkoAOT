+// GEKKOAOT_LFS_STFS_EXACT_V394: stfs is exact under FPSCR[NI], the host
+// conversion is not (FTZ). A result of the host conversion other than zero
+// needs nothing, and neither does a value single arithmetic produced under
+// the same controls, so only a zero result leaves the fast path.
+Value *FunctionEmitter::truncateForStore(Value *value, Type *resultType) {
+  Value *single = builder_.CreateFPTrunc(value, resultType);
+  if (isa<Constant>(value))
+    return single;
+  if (auto *load = dyn_cast<LoadInst>(value)) {
+    Value *pointer = load->getPointerOperand();
+    for (u32 reg = 0; reg < 32; reg++) {
+      if (pointer == state_[DOLIR_STATE_FPR0 + reg] && fp_denormal_safe_[reg])
+        return single;
+    }
+  }
+  Type *i32 = Type::getInt32Ty(context_);
+  Value *bits = builder_.CreateBitCast(single, i32);
+  Value *zero = builder_.CreateICmpEQ(
+      builder_.CreateAnd(bits, builder_.getInt32(0x7FFFFFFFu)),
+      builder_.getInt32(0));
+  BasicBlock *fast = builder_.GetInsertBlock();
+  BasicBlock *cold = BasicBlock::Create(context_, "stfs_tiny", function_);
+  BasicBlock *join = BasicBlock::Create(context_, "stfs_join", function_);
+  builder_.CreateCondBr(zero, cold, join,
+                        MDBuilder(context_).createBranchWeights(1, 4096));
+  builder_.SetInsertPoint(cold);
+  auto callee = module_.getOrInsertFunction(
+      "ppc_stfs_tiny",
+      FunctionType::get(i32, {Type::getDoubleTy(context_)}, false));
+  Value *exact = builder_.CreateCall(callee, {value});
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(join);
+  PHINode *merged = builder_.CreatePHI(i32, 2, "stfs.bits");
+  merged->addIncoming(bits, fast);
+  merged->addIncoming(exact, cold);
+  return builder_.CreateBitCast(merged, resultType);
+}
