@@ -11,6 +13,36 @@ namespace dolllvm {
 
 using namespace llvm;
 
+namespace {
+u32 configuredNativeBytes(const char *name, u32 fallback) {
+  const char *text = std::getenv(name);
+  if (!text || !*text)
+    return fallback;
+  char *end = nullptr;
+  errno = 0;
+  const unsigned long value = std::strtoul(text, &end, 10);
+  if (errno || !end || *end || value > 4096ul)
+    return fallback;
+  return static_cast<u32>(value);
+}
+
+u32 nativeInlineBytes() {
+  static const u32 value = configuredNativeBytes("DOLRECOMP_NATIVE_INLINE_BYTES", 256u);
+  return value;
+}
+
+u32 relaxedCallGuardBytes() {
+  static const u32 value = configuredNativeBytes("DOLRECOMP_RELAXED_CALL_GUARD_BYTES", 256u);
+  return value;
+}
+
+bool smallLinkedNativeCall(const DolIRTerminator &term,
+                           const DolLLVMFunctionRange *range) {
+  return term.linked && range && range->end > range->start &&
+         range->end - range->start <= relaxedCallGuardBytes();
+}
