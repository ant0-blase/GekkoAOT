+bool FunctionEmitter::isPurePollingLoop(u32 header) const {
+  if (header >= source_.block_count || !loop_headers_[header])
+    return false;
+
+  // Conservative, address-independent classifier for the common GameCube
+  // "wait until an interrupt/callback changes a RAM flag" pattern.  Do not
+  // recognize arbitrary computational loops: the loop must be short, linear,
+  // contain exactly one non-update integer load, write no memory, make no
+  // helper/runtime calls, and only redefine the GPR loaded from memory plus CR
+  // state used by the exit comparison.  This covers lbz/lhz/lwz flag waits
+  // while rejecting pointer walks, memcpy/checksum loops and CTR loops.
+  constexpr u32 kMaxPollBlocks = 8u;
+  const u32 limit =
+      source_.block_count - header < kMaxPollBlocks
+          ? source_.block_count
+          : header + kMaxPollBlocks;
+
+  for (u32 tail = header; tail < limit; ++tail) {
+    const DolIRTerminator &tailTerm = source_.blocks[tail].terminator;
+    if (tailTerm.kind != DOLIR_TERM_COND_BRANCH)
+      continue;
+
+    const bool back0 = tailTerm.targets[0] == header;
+    const bool back1 = tailTerm.targets[1] == header;
+    if (back0 == back1)
+      continue;
+
+    const u32 exitTarget = tailTerm.targets[back0 ? 1u : 0u];
+    if (exitTarget != DOLIR_NO_BLOCK && exitTarget >= header && exitTarget <= tail)
+      continue;
+
+    bool linear = true;
+    for (u32 member = header; member < tail; ++member) {
+      const DolIRTerminator &term = source_.blocks[member].terminator;
+      if (term.kind != DOLIR_TERM_FALLTHROUGH ||
+          term.targets[0] != member + 1u) {
+        linear = false;
+        break;
+      }
+    }
+    if (!linear)
+      continue;
+
+    bool safe = true;
+    bool sawLoad = false;
+    u32 loadedGpr = 32u;
+    u32 gprDefs = 0u;
+
+    for (u32 member = header; member <= tail && safe; ++member) {
+      const DolIRBlock &block = source_.blocks[member];
+      for (u32 index = 0; index < block.instruction_count; ++index) {
+        const DolIRInstruction &inst = block.instructions[index];
+
+        if (inst.op == DOLIR_OP_GUEST_STORE ||
+            inst.op == DOLIR_OP_HELPER_CALL ||
+            (inst.effects & (DOLIR_EFFECT_WRITE_MEMORY |
+                             DOLIR_EFFECT_MAY_EXIT |
+                             DOLIR_EFFECT_BARRIER)) != 0u) {
+          safe = false;
+          break;
+        }
+
+        if (inst.op == DOLIR_OP_GUEST_LOAD) {
+          // One stable-address scalar load is enough to model a flag wait.
+          // Restrict to non-update D-form integer loads.  The base GPR must not
+          // alias the destination, otherwise the effective address can change
+          // from one iteration to the next (pointer chase / stream scan).
+          if (sawLoad) {
+            safe = false;
+            break;
+          }
+          const u32 primary = block.raw >> 26u;
+          if (primary != 32u && primary != 34u &&
+              primary != 40u && primary != 42u) {
+            safe = false;
+            break;
+          }
+          const u32 rt = (block.raw >> 21u) & 31u;
+          const u32 ra = (block.raw >> 16u) & 31u;
+          if (rt == ra && ra != 0u) {
+            safe = false;
+            break;
+          }
+          sawLoad = true;
+          loadedGpr = rt;
+        }
+
+        for (u32 slot = 0; slot < DOLIR_STATE_COUNT; ++slot) {
+          const auto stateSlot = static_cast<DolIRStateSlot>(slot);
+          if (!dolir_state_mask_test(inst.state_defs, stateSlot))
+            continue;
+          if (stateSlot >= DOLIR_STATE_GPR0 && stateSlot <= DOLIR_STATE_GPR31) {
+            gprDefs |= 1u << (stateSlot - DOLIR_STATE_GPR0);
+            continue;
+          }
+          if (stateSlot == DOLIR_STATE_CR ||
+              (stateSlot >= DOLIR_STATE_CR0 && stateSlot <= DOLIR_STATE_CR7))
+            continue;
+          safe = false;
+          break;
+        }
+      }
+    }
+
+    if (safe && sawLoad && loadedGpr < 32u &&
+        gprDefs == (1u << loadedGpr))
+      return true;
+  }
+  return false;
+}
