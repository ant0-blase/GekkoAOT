diff --git a/src/cpu/cpu.h b/src/cpu/cpu.h
--- a/src/cpu/cpu.h
+++ b/src/cpu/cpu.h
@@ -144,0 +145,58 @@ void mem_write8(CPUState* cpu, u32 addr, u8 value);
+
+/* GekkoAOT v40 Portable-C 32-bit direct-memory fast path.
+ *
+ * Keep this deliberately small: 32-bit accesses dominate real Portable-C
+ * profiles, while forcing every 8/16/64-bit helper inline caused excessive C
+ * compile cost in older experiments.  The ordinary DolRecomp memory ABI stays
+ * the exact fallback for MMIO, unmapped addresses and unusual regions.
+ *
+ * The 0x40000000 bit distinguishes cached/uncached GameCube/Wii aliases, so
+ * canonicalising it is equivalent to resolve_addr() for MEM1/MEM2. */
+static inline u32 dolrecomp_mem_read32_fast(CPUState* cpu, u32 addr) {
+    const u32 canonical = addr & ~0x40000000u;
+
+    if (cpu->ram && cpu->ram_size >= 4u) {
+        const u32 offset = canonical - GC_RAM_BASE;
+        if (offset <= cpu->ram_size - 4u)
+            return read_be32(cpu->ram + offset);
+    }
+
+    if (cpu->mem2 && cpu->mem2_size >= 4u) {
+        const u32 offset = canonical - WII_MEM2_BASE;
+        if (offset <= cpu->mem2_size - 4u)
+            return read_be32(cpu->mem2 + offset);
+    }
+
+    return mem_read32(cpu, addr);
+}
+
+static inline void dolrecomp_mem_write32_fast(CPUState* cpu, u32 addr,
+                                               u32 value) {
+    const u32 canonical = addr & ~0x40000000u;
+
+    if (cpu->ram && cpu->ram_size >= 4u) {
+        const u32 offset = canonical - GC_RAM_BASE;
+        if (offset <= cpu->ram_size - 4u) {
+            const u32 reserve_addr = cpu->reserve_addr & ~0x40000000u;
+            if (cpu->reserve_valid && ((reserve_addr ^ canonical) & ~31u) == 0)
+                cpu->reserve_valid = false;
+            if (g_mem_write_journal)
+                g_mem_write_journal(offset, 4u, g_mem_write_journal_user);
+            write_be32(cpu->ram + offset, value);
+            return;
+        }
+    }
+
+    if (cpu->mem2 && cpu->mem2_size >= 4u) {
+        const u32 offset = canonical - WII_MEM2_BASE;
+        if (offset <= cpu->mem2_size - 4u) {
+            const u32 reserve_addr = cpu->reserve_addr & ~0x40000000u;
+            if (cpu->reserve_valid && ((reserve_addr ^ canonical) & ~31u) == 0)
+                cpu->reserve_valid = false;
+            write_be32(cpu->mem2 + offset, value);
+            return;
+        }
+    }
+
+    mem_write32(cpu, addr, value);
+}
