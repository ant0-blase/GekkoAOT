diff --git a/src/backend/llvm/register_state.cpp b/src/backend/llvm/register_state.cpp
--- a/src/backend/llvm/register_state.cpp
+++ b/src/backend/llvm/register_state.cpp
@@ -345,30 +345,6 @@
       }
     }
 
-    // GekkoAOT standalone has no interpreter safety net. A lazy-FPU
-    // unavailable exception returns with RFI to the faulting instruction, so
-    // every block containing the FP-availability gate must be directly
-    // enterable by the native wrapper. Without this, an RFI to e.g. NDDEMO
-    // 0x80062AC0 enters fallback_dispatch, executes one fallback instruction,
-    // advances to 0x80062AC4, then spins there forever even though ADDIS is
-    // fully lowered by DolIR.
-    //
-    // Key this narrowly on DOLIR_HELPER_FP_AVAILABLE instead of MAY_EXIT. The
-    // latter is intentionally too broad and fragments hot regions. This adds
-    // only architectural FP restart points, which are genuine external resume
-    // targets after lazy FPU exceptions.
-    {
-      const DolIRBlock &body = source_.blocks[i];
-      for (u32 n = 0; n < body.instruction_count; n++) {
-        const DolIRInstruction &inst = body.instructions[n];
-        if (inst.op == DOLIR_OP_HELPER_CALL &&
-            inst.aux == DOLIR_HELPER_FP_AVAILABLE) {
-          region_leaders_[i] = true;
-          break;
-        }
-      }
-    }
-
     // MTSPR is a host/runtime boundary and may return to the standalone
     // dispatcher at the architectural next PC. Exception handlers are a
     // concrete case: a DSI/ISI prologue may save state through SPRG0 and then
@@ -404,6 +380,58 @@
       continue;
     region_leaders_[(address - source_.guest_start) / 4u] = true;
   }
+
+  // GEKKOAOT_FP_REGION_COALESCE_V292: lazy-FPU exceptions can occur only at
+  // the first FP instruction of a linear, FP-only run. Once its availability
+  // gate has passed, whitelisted paired-single ALU ops cannot clear MSR[FP], call
+  // an external service, or fault on guest memory. Keeping a fresh region at
+  // every one of those operations discards exact-single provenance and forces
+  // repeated availability checks, pair widening, multiplier rounding and NaN
+  // fixups. Keep the first restart PC, and preserve every independently required
+  // branch/dispatch entry. Restrict the proof to consecutive FP ALU blocks; a
+  // memory, integer, scalar FP, MSR, SPR or unknown-helper op ends the run.
+  // Scalar FP remains separate: enabled exceptions can suppress a destination
+  // write, so its exact-single provenance needs a stronger success proof.
+  const char *fpSetting = std::getenv("DOLRECOMP_FP_REGION_COALESCE");
+  const bool coalesceFP = !fpSetting || std::string(fpSetting) != "0";
+  constexpr u32 kMaxPairedRun = 32;
+  u32 fpRunLength = 0;
+  bool fpRunAvailable = false;
+  for (u32 i = 0; i < source_.block_count; ++i) {
+    const DolIRBlock &body = source_.blocks[i];
+    if (region_leaders_[i]) {
+      fpRunAvailable = false;
+      fpRunLength = 0;
+    }
+    bool fpGate = false;
+    bool fpALU = (body.raw >> 26u) == 4u;
+    for (u32 n = 0; n < body.instruction_count; ++n) {
+      const DolIRInstruction &inst = body.instructions[n];
+      if (inst.op == DOLIR_OP_GUEST_LOAD || inst.op == DOLIR_OP_GUEST_STORE ||
+          (inst.effects & (DOLIR_EFFECT_READ_MEMORY |
+                           DOLIR_EFFECT_WRITE_MEMORY)) ||
+          dolir_state_mask_test(inst.state_defs, DOLIR_STATE_MSR))
+        fpALU = false;
+      if (inst.op != DOLIR_OP_HELPER_CALL) {
+        if (inst.effects & DOLIR_EFFECT_BARRIER)
+          fpALU = false;
+        continue;
+      }
+      if (inst.aux == DOLIR_HELPER_FP_AVAILABLE)
+        fpGate = true;
+      else if (inst.aux != DOLIR_HELPER_EXACT_PAIRED)
+        fpALU = false;
+    }
+    if (fpGate && (!coalesceFP || !fpRunAvailable || !fpALU ||
+                   fpRunLength >= kMaxPairedRun)) {
+      region_leaders_[i] = true;
+      fpRunLength = 0;
+    }
+    fpRunAvailable = coalesceFP && fpGate && fpALU &&
+                     body.terminator.kind == DOLIR_TERM_FALLTHROUGH &&
+                     body.terminator.targets[0] == i + 1u;
+    fpRunLength = fpRunAvailable ? fpRunLength + 1u : 0u;
+  }
 }
 
