+// A compat body cannot enter a native body directly: a cold escape unwinds to
+// the setjmp frame owned by the native entry wrapper. Calling that wrapper
+// keeps the call inside the chain instead of returning to the dispatcher and
+// re-entering this function through its resume switch for every call. The
+// wrapper loads its inputs from CPUState, settles its own cycles into downcount
+// and leaves the next PC in CPUState, so an escape looks like a PC mismatch.
+BasicBlock *FunctionEmitter::compatNativeCall(const DolIRTerminator &term,
+                                              const DolLLVMFunctionRange *range,
+                                              u32 target) {
+  static const bool enabled = [] {
+    const char *setting = std::getenv("DOLRECOMP_COMPAT_NATIVE_CALLS");
+    return !setting || std::string(setting) != "0";
+  }();
+  const u32 continuation = term.guest_pc + 4u;
+  const bool local = continuation >= source_.guest_start &&
+                     continuation < source_.guest_end &&
+                     ((continuation - source_.guest_start) & 3u) == 0;
+  const u32 continuationBlock =
+      local ? (continuation - source_.guest_start) / 4u : 0u;
+  if (!enabled || modern_runtime_ || !term.linked || !local ||
+      continuationBlock >= blocks_.size())
+    return nullptr;
+  BasicBlock *callBlock =
+      BasicBlock::Create(context_, "compat_native_call", function_);
+  IRBuilderBase::InsertPoint saved = builder_.saveIP();
+  builder_.SetInsertPoint(callBlock);
+  emitBudgetGuard(target);
+  materialize(target);
+  char name[64];
+  snprintf(name, sizeof(name), "func_%08X", range->start);
+  auto *pointer = PointerType::getUnqual(context_);
+  auto callee = module_.getOrInsertFunction(
+      symbolName(name),
+      FunctionType::get(Type::getVoidTy(context_), {pointer}, false));
+  if (auto *calleeFunction = dyn_cast<Function>(callee.getCallee())) {
+    calleeFunction->setCallingConv(CallingConv::C);
+    calleeFunction->setVisibility(GlobalValue::HiddenVisibility);
+    calleeFunction->setDSOLocal(true);
+  }
+  Value *before =
+      loadOffset(Type::getInt64Ty(context_), offsetof(CPUState, downcount));
+  CallInst *call = builder_.CreateCall(callee, {ctx_});
+  call->setCallingConv(CallingConv::C);
+  Value *after =
+      loadOffset(Type::getInt64Ty(context_), offsetof(CPUState, downcount));
+  // The callee's cycles count against this chain's guard like a direct call.
+  builder_.CreateStore(
+      builder_.CreateAdd(
+          builder_.CreateLoad(Type::getInt64Ty(context_), guard_cycles_local_),
+          builder_.CreateSub(before, after)),
+      guard_cycles_local_);
+  BasicBlock *resume = BasicBlock::Create(context_, "call_resume", function_);
+  BasicBlock *mismatch =
+      BasicBlock::Create(context_, "call_mismatch", function_);
+  Value *returnedPC =
+      loadOffset(Type::getInt32Ty(context_), offsetof(CPUState, pc));
+  builder_.CreateCondBr(
+      builder_.CreateICmpEQ(returnedPC, builder_.getInt32(continuation)),
+      resume, mismatch);
+  builder_.SetInsertPoint(mismatch);
+  returnFromBody();
+  builder_.SetInsertPoint(resume);
+  reloadUsedState();
+  builder_.CreateBr(blocks_[continuationBlock]);
+  builder_.restoreIP(saved);
+  return callBlock;
+}
