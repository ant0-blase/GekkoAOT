+// GEKKOAOT_INTERIOR_HOOK_V391: DOLRECOMP_INTERIOR_HOOKS lists "pc token" rows.
+// A hand-written host service may take over at that guest PC: it either
+// returns true with the next PC in CPUState, or declines and the guest code
+// runs on as if nothing happened.
+const std::unordered_map<u32, u32> &interiorHooks() {
+  static const std::unordered_map<u32, u32> hooks = [] {
+    std::unordered_map<u32, u32> result;
+    const char *path = std::getenv("DOLRECOMP_INTERIOR_HOOKS");
+    if (!path || !*path)
+      return result;
+    std::ifstream input(path);
+    unsigned long pc = 0, token = 0;
+    while (input >> std::hex >> pc >> token)
+      result[static_cast<u32>(pc)] = static_cast<u32>(token);
+    return result;
+  }();
+  return hooks;
+}
+
+void FunctionEmitter::emitInteriorHook(u32 pc, u32 token) {
+  Type *pointer = PointerType::getUnqual(context_);
+  materialize(pc);
+  Value *hostCall = loadOffset(pointer, offsetof(CPUState, host_call));
+  auto *hostCallType = FunctionType::get(
+      Type::getInt1Ty(context_), {pointer, Type::getInt32Ty(context_)}, false);
+  Value *handled =
+      builder_.CreateCall(hostCallType, hostCall, {ctx_, builder_.getInt32(token)});
+  BasicBlock *accepted =
+      BasicBlock::Create(context_, "interior_hook_accepted", function_);
+  BasicBlock *declined =
+      BasicBlock::Create(context_, "interior_hook_declined", function_);
+  builder_.CreateCondBr(handled, accepted, declined);
+  builder_.SetInsertPoint(accepted);
+  returnFromBody();
+  builder_.SetInsertPoint(declined);
+  reloadUsedState();
+}
