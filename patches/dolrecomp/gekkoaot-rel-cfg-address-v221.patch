+static void analyze_address_block(DolIRBlock* block, ConstantValue* values,
+                              ConstantValue* state) {
+    for (u32 index = 0; index < block->instruction_count; index++) {
+        DolIRInstruction* instruction = &block->instructions[index];
+        instruction->address_domain = DOLIR_ADDRESS_UNKNOWN;
+        instruction->address_lower = 0;
+        instruction->address_upper = 0;
+        if (instruction->op == DOLIR_OP_GUEST_STORE)
+            instruction->aux &= 0x7fffffffu;
+        if (instruction->op == DOLIR_OP_GUEST_LOAD ||
+            instruction->op == DOLIR_OP_GUEST_STORE) {
+            ConstantValue address_value = values[instruction->operands[0]];
+            if (address_value.known) {
+                u32 address = (u32)address_value.bits;
+                instruction->address_domain = classify_address(address);
+                instruction->address_lower = address;
+                instruction->address_upper = address;
+            } else if (address_value.relocatable_mem1) {
+                instruction->address_domain = DOLIR_ADDRESS_MEM1;
+                instruction->address_lower = address_value.relocatable_base;
+                // Sentinel: static MEM1 base is proven, final indexed EA is dynamic.
+                instruction->address_upper = 0xffffffffu;
+            }
+        }
+        // A REL can materialize a canonical pointer and store it into guest
+        // memory (for example an interface/data pointer published by its
+        // prolog).  Mark only 32-bit store values with static MEM1 proof;
+        // the LLVM backend will run them through the same canonical->live
+        // OSLink translator used for proven REL effective addresses.
+        if (instruction->op == DOLIR_OP_GUEST_STORE &&
+            instruction->operand_count >= 2u) {
+            ConstantValue stored_value = values[instruction->operands[1]];
+            // v199: this is only a cheap compile-time *candidate* bit.
+            // A classic REL prolog (lis/addi/stw) folds its relocated
+            // address to a known constant, losing v171's dynamic-index
+            // provenance. The generated per-REL helper performs the
+            // authoritative own-data + cross-module check at runtime, so
+            // known MEM1 values are safe to admit here without repeating
+            // v195's broad rewrite.
+            if (stored_value.relocatable_mem1 ||
+                (stored_value.known && is_mem1_constant(stored_value.bits)))
+                instruction->aux |= 0x80000000u;
+        }
+        ConstantValue result =
+            instruction_value(instruction, values, state);
+        if (instruction->result)
+            values[instruction->result] = result;
+        if (instruction->op == DOLIR_OP_STATE_WRITE)
+            state[instruction->aux] =
+                values[instruction->operands[0]];
+        for (u32 slot = 0; slot < DOLIR_STATE_COUNT; slot++)
+            if (dolir_state_mask_test(instruction->state_defs,
+                                      (DolIRStateSlot)slot) &&
+                !(instruction->op == DOLIR_OP_STATE_WRITE &&
+                  instruction->aux == slot))
+                state[slot] = unknown_value();
+    }
+}
