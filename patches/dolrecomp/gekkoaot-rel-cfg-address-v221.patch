+// v221: REL static bases survive control-flow edges. A linear region scan
+// erased r3 at loop leaders, so an invariant relocated base became an ordinary
+// heap pointer and its next load read the synthetic compilation window.
+static bool analyze_rel_cfg_addresses(DolIRFunction* function) {
+    const u32 count = function->block_count;
+    const size_t slots = (size_t)count * DOLIR_STATE_COUNT;
+    ConstantValue* inputs = calloc(slots, sizeof(*inputs));
+    ConstantValue* values = calloc(function->value_count, sizeof(*values));
+    bool* initialized = calloc(count, sizeof(*initialized));
+    bool* dirty = calloc(count, sizeof(*dirty));
+    u32* predecessors = calloc(count, sizeof(*predecessors));
+    if (!inputs || !values || !initialized || !dirty || !predecessors) {
+        free(inputs); free(values); free(initialized); free(dirty); free(predecessors);
+        return false;
+    }
+    for (u32 i = 0; i < count; i++) {
+        const DolIRTerminator* term = &function->blocks[i].terminator;
+        for (u32 slot = 0; slot < terminator_target_count(term->kind); slot++) {
+            u32 target = term->targets[slot];
+            if (target < count) predecessors[target]++;
+        }
+        if (term->kind == DOLIR_TERM_FALLTHROUGH && i + 1u < count)
+            predecessors[i + 1u]++;
+    }
+    // Calls/fallbacks may return with arbitrary architectural register values.
+    // Seed their continuations independently rather than carrying caller proof.
+    initialized[0] = dirty[0] = true;
+    for (u32 i = 0; i < count; i++) {
+        const DolIRTerminator* term = &function->blocks[i].terminator;
+        if (!predecessors[i] || term->kind == DOLIR_TERM_FALLBACK)
+            initialized[i] = dirty[i] = true;
+        if (i + 1u < count && (term->linked ||
+            (term->kind != DOLIR_TERM_FALLTHROUGH &&
+             term->kind != DOLIR_TERM_BRANCH &&
+             term->kind != DOLIR_TERM_COND_BRANCH)))
+            initialized[i + 1u] = dirty[i + 1u] = true;
+    }
+    bool pending = true;
+    while (pending) {
+        pending = false;
+        for (u32 i = 0; i < count; i++) {
+            if (!dirty[i]) continue;
+            dirty[i] = false;
+            ConstantValue state[DOLIR_STATE_COUNT];
+            memcpy(state, inputs + (size_t)i * DOLIR_STATE_COUNT, sizeof(state));
+            analyze_address_block(&function->blocks[i], values, state);
+            const DolIRTerminator* term = &function->blocks[i].terminator;
+            if (term->linked || term->kind == DOLIR_TERM_INDIRECT ||
+                term->kind == DOLIR_TERM_FALLBACK)
+                memset(state, 0, sizeof(state));
+            u32 targets[2] = {DOLIR_NO_BLOCK, DOLIR_NO_BLOCK};
+            u32 edges = terminator_target_count(term->kind);
+            for (u32 slot = 0; slot < edges; slot++) targets[slot] = term->targets[slot];
+            if (term->kind == DOLIR_TERM_FALLTHROUGH && i + 1u < count) {
+                targets[0] = i + 1u; edges = 1;
+            }
+            for (u32 edge = 0; edge < edges; edge++) {
+                const u32 target = targets[edge];
+                if (target >= count) continue;
+                ConstantValue* in = inputs + (size_t)target * DOLIR_STATE_COUNT;
+                bool changed = false;
+                if (!initialized[target]) {
+                    memcpy(in, state, sizeof(state));
+                    initialized[target] = true; changed = true;
+                } else {
+                    for (u32 slot = 0; slot < DOLIR_STATE_COUNT; slot++) {
+                        ConstantValue old = in[slot], next = state[slot];
+                        const bool equal = (old.known && next.known && old.bits == next.bits) ||
+                            (old.relocatable_mem1 && next.relocatable_mem1 &&
+                             old.relocatable_base == next.relocatable_base);
+                        if ((old.known || old.relocatable_mem1) && !equal) {
+                            in[slot] = unknown_value(); changed = true;
+                        }
+                    }
+                }
+                if (changed) { dirty[target] = true; pending = true; }
+            }
+        }
+    }
+    free(inputs); free(values); free(initialized); free(dirty); free(predecessors);
+    return true;
+}
