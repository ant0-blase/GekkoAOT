+// GEKKOAOT_PSQ_EXTEND_FAST_V331: the exact single->double expansion above is
+// ~30 host instructions per lane and was always evaluated (if-converted), on
+// every psq_l f32 lane. For zero, normal and infinite inputs the host widening
+// is exact and independent of rounding mode and DAZ, so it is the common path;
+// subnormals (DAZ under FPSCR[NI]) and NaNs (SNaN quieting) call the exact
+// expansion out of line.
+static Function *exactExtendPSQFloatFunction(Module &module) {
+  constexpr const char *name = "psq_extend_exact_f32";
+  if (Function *existing = module.getFunction(name))
+    return existing;
+  LLVMContext &context = module.getContext();
+  Function *function = Function::Create(
+      FunctionType::get(Type::getDoubleTy(context), {Type::getInt32Ty(context)},
+                        false),
+      GlobalValue::InternalLinkage, name, module);
+  function->setCallingConv(CallingConv::PreserveAll);
+  function->addFnAttr(Attribute::Cold);
+  function->addFnAttr(Attribute::NoInline);
+  function->addFnAttr(Attribute::NoUnwind);
+  function->addFnAttr(Attribute::WillReturn);
+  function->setMemoryEffects(MemoryEffects::none());
+  if (!Triple(module.getTargetTriple()).isOSBinFormatMachO())
+    function->setSection(".text.unlikely." + function->getName().str());
+  IRBuilder<> body(BasicBlock::Create(context, "entry", function));
+  body.CreateRet(exactExtendPSQFloat(body, module, function->getArg(0)));
+  return function;
+}
