+Value *extendPSQFloat(IRBuilder<> &builder, Module &module, Value *bits) {
+  static const bool fast = [] {
+    const char *setting = std::getenv("DOLRECOMP_PSQ_EXTEND_FAST");
+    return !setting || setting[0] != '0';
+  }();
+  BasicBlock *current = builder.GetInsertBlock();
+  if (!fast || !current || !current->getParent())
+    return exactExtendPSQFloat(builder, module, bits);
+  Function *parent = current->getParent();
+  LLVMContext &context = module.getContext();
+  Value *magnitude = builder.CreateAnd(bits, builder.getInt32(0x7fffffffu));
+  Value *subnormal = builder.CreateICmpULT(
+      builder.CreateSub(magnitude, builder.getInt32(1)),
+      builder.getInt32(0x007fffffu));
+  Value *nan = builder.CreateICmpUGT(magnitude, builder.getInt32(0x7f800000u));
+  BasicBlock *common = BasicBlock::Create(context, "psq_extend_fast", parent);
+  BasicBlock *exact = BasicBlock::Create(context, "psq_extend_exact", parent);
+  BasicBlock *join = BasicBlock::Create(context, "psq_extend_join", parent);
+  builder.CreateCondBr(builder.CreateOr(subnormal, nan), exact, common,
+                       MDBuilder(context).createBranchWeights(1, 2000));
+  builder.SetInsertPoint(common);
+  Value *widened = builder.CreateFPExt(
+      builder.CreateBitCast(bits, builder.getFloatTy()), builder.getDoubleTy());
+  builder.CreateBr(join);
+  builder.SetInsertPoint(exact);
+  CallInst *slow =
+      builder.CreateCall(exactExtendPSQFloatFunction(module), {bits});
+  slow->setCallingConv(CallingConv::PreserveAll);
+  builder.CreateBr(join);
+  builder.SetInsertPoint(join);
+  PHINode *result = builder.CreatePHI(builder.getDoubleTy(), 2);
+  result->addIncoming(widened, common);
+  result->addIncoming(slow, exact);
+  return result;
+}
