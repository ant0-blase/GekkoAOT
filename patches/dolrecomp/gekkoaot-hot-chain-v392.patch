 void FunctionEmitter::chargeCycles(u32 cycles) {
+  // A chain charges its instructions in one add at its end: per-instruction
+  // adds are a long dependency chain through the stack in large functions.
+  if (hot_chain_) {
+    lazy_cycles_ += cycles;
+    return;
+  }
+  chargeCycles(ConstantInt::get(Type::getInt64Ty(context_), cycles));
+}
+
+void FunctionEmitter::flushLazyCycles() {
+  if (!lazy_cycles_)
+    return;
+  const u64 cycles = lazy_cycles_;
+  lazy_cycles_ = 0;
   chargeCycles(ConstantInt::get(Type::getInt64Ty(context_), cycles));
 }
 
