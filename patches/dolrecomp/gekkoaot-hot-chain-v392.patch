+bool FunctionEmitter::regionEnds(u32 index) const {
+  return hot_chain_ && !emitting_restart_ ? hard_leaders_[index]
+                                          : region_leaders_[index];
+}
+
+BasicBlock *FunctionEmitter::regionTarget(u32 index) const {
+  return emitting_restart_ && restart_blocks_[index] ? restart_blocks_[index]
+                                                     : blocks_[index];
+}
+
+BasicBlock *FunctionEmitter::entryBlock(u32 index) const {
+  return restart_blocks_[index] ? restart_blocks_[index] : blocks_[index];
+}
+
+FunctionEmitter::EmitFacts FunctionEmitter::captureFacts() const {
+  return {fp_rep_,          fp_exact_single_,      fp_denormal_safe_,
+          fp_value_class_,  known_state_,          fp_available_checked_,
+          psq_direct_proven_, psq_indexed_proven_};
+}
+
+void FunctionEmitter::restoreFacts(const EmitFacts &facts) {
+  fp_rep_ = facts.fp_rep;
+  fp_exact_single_ = facts.fp_exact_single;
+  fp_denormal_safe_ = facts.fp_denormal_safe;
+  fp_value_class_ = facts.fp_value_class;
+  known_state_ = facts.known_state;
+  fp_available_checked_ = facts.fp_available_checked;
+  psq_direct_proven_ = facts.psq_direct_proven;
+  psq_indexed_proven_ = facts.psq_indexed_proven;
+}
+
 Value *FunctionEmitter::bytePtr(size_t offset) {
   return builder_.CreateInBoundsGEP(Type::getInt8Ty(context_), ctx_,
                                     builder_.getInt64(offset));
