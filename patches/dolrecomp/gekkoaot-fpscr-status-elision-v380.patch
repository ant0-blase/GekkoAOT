--- /dev/null
+++ b/src/backend/llvm/fpscr_status.h
@@ -0,0 +1,23 @@
+#ifndef DOLRECOMP_LLVM_FPSCR_STATUS_H
+#define DOLRECOMP_LLVM_FPSCR_STATUS_H
+
+#include <cstdlib>
+
+namespace dolllvm {
+
+// GEKKOAOT_FPSCR_STATUS_ELISION_V380: when the host proves that no guest code
+// reads FPSCR status (no mcrfs or record-form FP, and mffs only inside the OS
+// FPU-context save that copies it verbatim), arithmetic need not maintain
+// FPRF/FPCC/FI/FR/XX/FX/VX/FEX. Results, rounding and FPSCR controls (RN, NI)
+// are unchanged; only the unobservable status bits stop being computed.
+inline bool fpscrStatusElided() {
+  static const bool elided = [] {
+    const char *setting = std::getenv("DOLRECOMP_FPSCR_STATUS");
+    return setting && setting[0] == '0';
+  }();
+  return elided;
+}
+
+} // namespace dolllvm
+
+#endif
