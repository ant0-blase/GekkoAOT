+// CrossGameDB supplies normalized PPC matches, never executable replacements.
+// Unlike adaptiveHot(), this does not alter state residency or guest lowering.
+static u32 markCrossGameHotFunctions(Module &module) {
+  const char *path = std::getenv("DOLRECOMP_CROSSGAME_HOT_FUNCTIONS");
+  if (!path || !*path) return 0;
+  std::ifstream input(path);
+  std::string symbol;
+  u32 marked = 0;
+  while (std::getline(input, symbol)) {
+    if (!symbol.empty() && symbol.back() == '\r') symbol.pop_back();
+    if (symbol.size() != 20 || symbol.compare(0, 5, "func_") != 0 ||
+        symbol.compare(13, 7, "_budget") != 0 ||
+        symbol.find_first_not_of("0123456789abcdefABCDEF", 5) != 13)
+      continue;
+    if (Function *function = module.getFunction(symbol)) {
+      if (!function->hasFnAttribute(Attribute::Hot)) {
+        function->addFnAttr(Attribute::Hot);
+        ++marked;
+      }
+    }
+  }
+  return marked;
+}
