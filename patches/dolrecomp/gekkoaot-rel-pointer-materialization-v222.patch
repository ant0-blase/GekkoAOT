diff --git a/src/backend/llvm/rel_pointer_manifest.h b/src/backend/llvm/rel_pointer_manifest.h
new file mode 100644
--- /dev/null
+++ b/src/backend/llvm/rel_pointer_manifest.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <unordered_map>
+namespace dolllvm {
+inline char relPointerKindV222(unsigned pc) {
+  const char* enabled = std::getenv("DOLRECOMP_REL_RUNTIME_TRANSLATE");
+  if (!enabled || !enabled[0] || enabled[0] == '0') return 0;
+  // This is proof from the REL relocation stream, not a numeric RAM heuristic.
+  static const auto kinds = [] {
+    std::unordered_map<unsigned, char> result;
+    const char* path = std::getenv("DOLRECOMP_REL_POINTER_MANIFEST");
+    if (!path || !path[0]) return result;
+    std::ifstream input(path);
+    if (!input) throw std::runtime_error("cannot open REL pointer manifest");
+    unsigned address; char kind;
+    while (input >> std::hex >> address >> kind) result.emplace(address, kind);
+    return result;
+  }();
+  auto found = kinds.find(pc);
+  return found == kinds.end() ? 0 : found->second;
+}
+}
