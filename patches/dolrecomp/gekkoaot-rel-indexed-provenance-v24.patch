diff --git a/tests/test_dolir.c b/tests/test_dolir.c
--- a/tests/test_dolir.c
+++ b/tests/test_dolir.c
@@ -97,0 +97,54 @@
+    // Static REL table base + runtime index must retain enough provenance for
+    // GekkoAOT's canonical->OSLink bridge.  The effective address itself is not
+    // constant, so address_upper uses the dynamic-index sentinel.
+    PPCInst indexed_insts[] = {
+        decode(0x3C808050u, 0x80002520u), // lis r4, 0x8050
+        decode(0x7C64282Eu, 0x80002524u), // lwzx r3, r4, r5
+        decode(0x7C64292Eu, 0x80002528u), // stwx r3, r4, r5
+        decode(0x4E800020u, 0x8000252Cu),
+    };
+    dolir_module_init(&module);
+    CHECK(dolir_build_chunk(&module, indexed_insts, 4, 0x80002520u));
+    CHECK(dolir_verify(&module, stderr));
+    memory_ops = 0;
+    for (u32 b = 0; b < module.functions[0].block_count; b++) {
+        DolIRBlock* block = &module.functions[0].blocks[b];
+        for (u32 i = 0; i < block->instruction_count; i++) {
+            DolIRInstruction* instruction = &block->instructions[i];
+            if (instruction->op != DOLIR_OP_GUEST_LOAD &&
+                instruction->op != DOLIR_OP_GUEST_STORE)
+                continue;
+            CHECK(instruction->address_domain == DOLIR_ADDRESS_MEM1);
+            CHECK(instruction->address_lower == 0x80500000u);
+            CHECK(instruction->address_upper == 0xffffffffu);
+            memory_ops++;
+        }
+    }
+    CHECK(memory_ops == 2);
+    dolir_module_free(&module);
+
+    // A pointer fetched from guest RAM is already an OSLink/runtime address.
+    // Even if its eventual numeric value lands inside 0x805xxxxx, analysis must
+    // not invent REL provenance for a subsequent indexed access.
+    PPCInst loaded_pointer_insts[] = {
+        decode(0x80830000u, 0x80002540u), // lwz r4, 0(r3)
+        decode(0x7CA4302Eu, 0x80002544u), // lwzx r5, r4, r6
+        decode(0x4E800020u, 0x80002548u),
+    };
+    dolir_module_init(&module);
+    CHECK(dolir_build_chunk(&module, loaded_pointer_insts, 3, 0x80002540u));
+    CHECK(dolir_verify(&module, stderr));
+    memory_ops = 0;
+    for (u32 b = 0; b < module.functions[0].block_count; b++) {
+        DolIRBlock* block = &module.functions[0].blocks[b];
+        for (u32 i = 0; i < block->instruction_count; i++) {
+            DolIRInstruction* instruction = &block->instructions[i];
+            if (instruction->op != DOLIR_OP_GUEST_LOAD)
+                continue;
+            CHECK(instruction->address_domain == DOLIR_ADDRESS_UNKNOWN);
+            memory_ops++;
+        }
+    }
+    CHECK(memory_ops == 2);
+    dolir_module_free(&module);
+
