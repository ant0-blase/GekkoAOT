@@ -38,0 +40,12 @@
+static ConstantValue relocatable_mem1_value(u32 base) {
+    ConstantValue value = {0, false, true, base};
+    return value;
+}
+
+static bool is_mem1_constant(u64 bits) {
+    const u32 address = (u32)bits;
+    const u32 normalized = address & ~0x40000000u;
+    return normalized >= GC_RAM_BASE &&
+           normalized < GC_RAM_BASE + GC_MAIN_RAM_SIZE;
+}
