@@ -63,1 +81,1 @@
-    if (!left.known || !right.known || !width)
+    if (!width)
@@ -65,0 +83,27 @@
+
+    // v171: preserve proof that an effective address was formed from a static
+    // MEM1 base plus a runtime index. REL code frequently accesses relocated
+    // tables with lwzx/stwx. The final EA is dynamic, but it still needs the
+    // canonical->OSLink translation. A pointer loaded from guest RAM carries no
+    // such proof and therefore remains identity-mapped.
+    if (width == 32 && instruction->op == DOLIR_OP_ADD) {
+        if (left.relocatable_mem1 && !right.relocatable_mem1)
+            return relocatable_mem1_value(left.relocatable_base);
+        if (right.relocatable_mem1 && !left.relocatable_mem1)
+            return relocatable_mem1_value(right.relocatable_base);
+        if (left.known && !right.known && !right.relocatable_mem1 &&
+            is_mem1_constant(left.bits))
+            return relocatable_mem1_value((u32)left.bits);
+        if (right.known && !left.known && !left.relocatable_mem1 &&
+            is_mem1_constant(right.bits))
+            return relocatable_mem1_value((u32)right.bits);
+    } else if (width == 32 && instruction->op == DOLIR_OP_SUB) {
+        if (left.relocatable_mem1 && !right.relocatable_mem1)
+            return relocatable_mem1_value(left.relocatable_base);
+        if (left.known && !right.known && !right.relocatable_mem1 &&
+            is_mem1_constant(left.bits))
+            return relocatable_mem1_value((u32)left.bits);
+    }
+
+    if (!left.known || !right.known)
+        return unknown_value();
@@ -157,0 +202,3 @@
+        if (yes.relocatable_mem1 && no.relocatable_mem1 &&
+            yes.relocatable_base == no.relocatable_base)
