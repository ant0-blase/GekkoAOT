+Value *FunctionEmitter::adaptiveStackMemoryPointer(Value *address, u32 width,
+                                                   Value **offset) {
+  // WiiCompiled's StackAddressFacts/GuestMemoryRangeLowering gets much of its
+  // win by proving that r1-relative accesses stay inside guest RAM and then
+  // reusing a resolved host base. DolRecomp already promotes PGO-hot state to
+  // SSA, so recognise the same affine shape directly in LLVM IR. The Gekko ABI
+  // requires r1 to be a valid cached MEM1 stack pointer; keep the accepted
+  // displacement deliberately small so this cannot turn arbitrary pointer
+  // arithmetic into a host access.
+  constexpr auto stackSlot =
+      static_cast<DolIRStateSlot>(DOLIR_STATE_GPR0 + 1);
+  if (!adaptiveHot() || !fixed_memory_layout_ || expected_mem2_size_ != 0u ||
+      expected_ram_size_ < 8192u || !offset || !state_[stackSlot])
+    return nullptr;
+
+  Value *cursor = address;
+  s64 displacement = 0;
+  for (u32 depth = 0; depth < 4u; ++depth) {
+    if (auto *load = dyn_cast<LoadInst>(cursor)) {
+      Value *source = load->getPointerOperand()->stripPointerCasts();
+      Value *stack = state_[stackSlot]->stripPointerCasts();
+      if (source != stack)
+        return nullptr;
+      if (displacement < -4096ll ||
+          displacement > 4096ll - static_cast<s64>(width))
+        return nullptr;
+
+      Value *normalizedStack = normalizeAddress(load);
+      Value *stackOffset = builder_.CreateSub(
+          normalizedStack, builder_.getInt32(GC_RAM_BASE), "stack.mem1.base");
+      *offset = builder_.CreateAdd(
+          stackOffset,
+          builder_.getInt32(static_cast<u32>(static_cast<s32>(displacement))),
+          "stack.mem1.offset");
+      function_->addFnAttr("dolrecomp-adaptive-stack-range", "mem1-4k");
+      return builder_.CreateInBoundsGEP(Type::getInt8Ty(context_), ram_, *offset,
+                                        "stack.mem1.ptr");
+    }
+
+    auto *binary = dyn_cast<BinaryOperator>(cursor);
+    if (!binary)
+      return nullptr;
+    ConstantInt *constant = dyn_cast<ConstantInt>(binary->getOperand(1));
+    Value *next = binary->getOperand(0);
+    bool subtract = binary->getOpcode() == Instruction::Sub;
+    if (!constant && binary->getOpcode() == Instruction::Add) {
+      constant = dyn_cast<ConstantInt>(binary->getOperand(0));
+      next = binary->getOperand(1);
+    }
+    if (!constant || (binary->getOpcode() != Instruction::Add && !subtract))
+      return nullptr;
+    const s64 delta = constant->getSExtValue();
+    displacement += subtract ? -delta : delta;
+    cursor = next;
+  }
+  return nullptr;
+}
