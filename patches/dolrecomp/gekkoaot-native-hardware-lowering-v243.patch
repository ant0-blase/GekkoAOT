+const char *FunctionEmitter::provenHardwareSymbol(
+    const DolIRInstruction &instruction, Value *address, u32 width, bool read) {
+  const char *enabled = std::getenv("DOLRECOMP_NATIVE_HARDWARE_LOWERING");
+  if (!enabled || std::string(enabled) != "1" || modern_runtime_ ||
+      (instruction.address_domain != DOLIR_ADDRESS_MMIO &&
+       instruction.address_domain != DOLIR_ADDRESS_FIFO) ||
+      instruction.address_lower != instruction.address_upper)
+    return nullptr;
+  const u32 physical = instruction.address_lower & 0x3fffffffu;
+  const char *symbol = nullptr;
+  if (read && width == 2u && !(physical & 1u)) {
+    if (physical >= 0x0c000000u && physical < 0x0c001000u)
+      symbol = "gekkoaot_cp_read16";
+    else if (physical >= 0x0c002000u && physical <= 0x0c002074u)
+      symbol = "gekkoaot_vi_read16";
+  } else if (!read) {
+    if (width == 4u && !(physical & 3u) &&
+        physical >= 0x0c003000u && physical < 0x0c004000u)
+      symbol = "gekkoaot_pi_write32";
+    else if (physical >= 0x0c008000u && physical < 0x0c008020u &&
+             (width == 1u || width == 2u || width == 4u || width == 8u))
+      symbol = "gekkoaot_wgpipe_write";
+  }
+  if (symbol) function_->addFnAttr("dolrecomp-native-hardware-lowering", "243");
+  return symbol;
 }
 
