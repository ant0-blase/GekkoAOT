-  PassBuilder builder(&machine, tuning, pgo);
+  // Multi-entry native functions contain large resume/state graphs. Keep SLP
+  // for ordinary functions, but bound its quadratic search in oversized ones.
+  unsigned slp_limit = 8192;
+  if (const char *text = std::getenv("DOLRECOMP_LLVM_SLP_MAX_INSTRUCTIONS")) {
+    char *end = nullptr;
+    const auto value = std::strtoul(text, &end, 10);
+    if (end && !*end && value >= 64 && value <= 1048576)
+      slp_limit = static_cast<unsigned>(value);
+  }
+  PassInstrumentationCallbacks callbacks;
+  callbacks.registerShouldRunOptionalPassCallback(
+      [&](StringRef pass, Any ir) {
+        if (pass != "SLPVectorizerPass") return true;
+        const auto *unit = any_cast<const Function *>(&ir);
+        if (!unit) return true;
+        unsigned instructions = 0;
+        for (const auto &block : **unit) {
+          instructions += block.size();
+          if (instructions > slp_limit) {
+            if (std::getenv("DOLRECOMP_LLVM_TIMINGS"))
+              std::fprintf(stderr, "dolllvm SLP bounded function=%s limit=%u\n",
+                           (*unit)->getName().str().c_str(), slp_limit);
+            return false;
+          }
+        }
+        return true;
+      });
+  PassBuilder builder(&machine, tuning, pgo, &callbacks);
   builder.registerModuleAnalyses(modules);
