+static void configureGekkoAOTLlvmOptions(const DolLLVMOptions &) {
 
   static std::once_flag once;
   std::call_once(once, [] {
-    const char *argv[] = {"dolrecomp"};
-    llvm::cl::ParseCommandLineOptions(1, argv, "", nullptr,
+    // Native resume entries create large live ranges. Bound repeated expensive
+    // joins while retaining the normal allocator and O3 IR optimizations.
+    // LLVM already uses these thresholds to cap coalescing compile time.
+    const auto limit = [](const char *name, unsigned fallback) {
+      const char *text = std::getenv(name);
+      if (!text || !*text) return fallback;
+      char *end = nullptr;
+      const auto value = std::strtoul(text, &end, 10);
+      return end && !*end && value >= 1 && value <= 4096
+                 ? static_cast<unsigned>(value) : fallback;
+    };
+    const std::string size = "-large-interval-size-threshold=" +
+        std::to_string(limit("DOLRECOMP_LLVM_COALESCE_SIZE", 100));
+    const std::string frequency = "-large-interval-freq-threshold=" +
+        std::to_string(limit("DOLRECOMP_LLVM_COALESCE_LIMIT", 32));
+    const char *argv[] = {"dolrecomp", size.c_str(), frequency.c_str()};
+    llvm::cl::ParseCommandLineOptions(3, argv, "", nullptr,
                                       "DOLRECOMP_LLVM_OPTIONS");
   });
 }
