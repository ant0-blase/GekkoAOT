+static int gekkoaot_llvm_env_enabled(const char* name, int fallback) {
+    const char* value = getenv(name);
+    if (!value || !value[0])
+        return fallback;
+    if (value[0] == '0' && value[1] == '\0')
+        return 0;
+    if (value[0] == '1' && value[1] == '\0')
+        return 1;
+    return fallback;
+}
+
+static u32 llvm_ir_optimization_level(void) {
+    const char* configured = getenv("DOLRECOMP_LLVM_IR_LEVEL");
+    if (!configured || !configured[0])
+        return 3u;
+    char* end = NULL;
+    errno = 0;
+    unsigned long value = strtoul(configured, &end, 10);
+    if (errno || !end || *end || value > 3u) {
+        fprintf(stderr,
+                "warning: DOLRECOMP_LLVM_IR_LEVEL must be 0..3; using 3\n");
+        return 3u;
+    }
+    return (u32)value;
+}
+
+static int llvm_emit_thinlto(void) {
+    return gekkoaot_llvm_env_enabled("DOLRECOMP_LLVM_EMIT_THINLTO", 1);
+}
