+  builder_.SetInsertPoint(clear);
+  builder_.CreateStore(builder_.getFalse(), state_[DOLIR_STATE_RESERVE_VALID]);
+  builder_.CreateBr(done);
+
+  builder_.SetInsertPoint(done);
