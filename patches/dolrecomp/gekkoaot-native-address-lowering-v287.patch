 namespace dolllvm {
 
 using namespace llvm;
+
+// The range/width guards remain at each admission point. Once admitted, use
+// one 64-bit host addition with a zero-extended canonical EA. A null service
+// uses the old RAM allocation through a body-local bias, without per-access
+// branches or callbacks. Endian, polling, reservation and journals are intact.
+Value *FunctionEmitter::nativeMemoryPointer(Value *address, Value *memory, Value *offset) {
+  Value* bias = memory == ram_ ? native_mem1_bias_ : native_mem2_bias_;
+  if (!bias) return builder_.CreateInBoundsGEP(Type::getInt8Ty(context_), memory, offset);
+  Value* ea = builder_.CreateZExt(address, builder_.getInt64Ty());
+  return builder_.CreateIntToPtr(builder_.CreateAdd(bias, ea, "host.base.plus.ea"),
+                                PointerType::getUnqual(context_));
+}
 
