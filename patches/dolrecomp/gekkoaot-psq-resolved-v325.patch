+// GEKKOAOT_PSQ_RESOLVED_V325: v320 sent every quantized psq to the C helper,
+// whose memory reads only know MEM1 and otherwise call the external service.
+// HPCOS streams quantized vertices through the locked cache (~8.6M external
+// accesses/s). Resolve the full 8-byte psq window once - MEM1, locked cache,
+// flat or paged VM, exactly the regions the per-lane ladders admit - and let
+// the caller decode/encode every GQR type from that host pointer.
+bool FunctionEmitter::psqResolvedPath() const {
+  static const bool enabled = [] {
+    const char *setting = std::getenv("DOLRECOMP_PSQ_RESOLVED");
+    return !setting || setting[0] != '0';
+  }();
+  return enabled && fixed_memory_layout_ && expected_mem2_size_ == 0 &&
+         expected_ram_size_ >= 8u;
+}
+
+Value *FunctionEmitter::psqHostPointer(Value *address, bool write,
+                                       BasicBlock *miss) {
+  constexpr u32 span = 8u;
+  Type *pointer = PointerType::getUnqual(context_);
+  BasicBlock *resolved = BasicBlock::Create(context_, "psq_resolved", function_);
+  SmallVector<std::pair<Value *, BasicBlock *>, 4> incoming;
+
+  Value *normalized = normalizeAddress(address);
+  Value *mem1Offset = builder_.CreateSub(normalized, builder_.getInt32(GC_RAM_BASE));
+  BasicBlock *mem1 = BasicBlock::Create(context_, "psq_resolve_mem1", function_);
+  BasicBlock *other = BasicBlock::Create(context_, "psq_resolve_other", function_);
+  // A MEM1 store journals each lane; keep journaled builds on the lane path.
+  Value *mem1Admitted = builder_.CreateICmpULE(
+      mem1Offset, builder_.getInt32(expected_ram_size_ - span));
+  if (write && write_journal_)
+    mem1Admitted = builder_.getFalse();
+  builder_.CreateCondBr(mem1Admitted, mem1, other,
+                        MDBuilder(context_).createBranchWeights(2000, 1));
+  builder_.SetInsertPoint(mem1);
+  incoming.push_back({nativeMemoryPointer(normalized, ram_, mem1Offset),
+                      builder_.GetInsertBlock()});
+  builder_.CreateBr(resolved);
+
+  builder_.SetInsertPoint(other);
+  if (native_locked_cache_base_) {
+    Value *offset = builder_.CreateSub(address, builder_.getInt32(0xe0000000u));
+    Value *admitted = builder_.CreateAnd(
+        builder_.CreateIsNotNull(native_locked_cache_base_),
+        builder_.CreateICmpULE(offset, builder_.getInt32(0x40000u - span)));
+    auto *direct = BasicBlock::Create(context_, "psq_resolve_locked_cache", function_);
+    auto *next = BasicBlock::Create(context_, "psq_resolve_vm", function_);
+    builder_.CreateCondBr(admitted, direct, next);
+    builder_.SetInsertPoint(direct);
+    incoming.push_back({builder_.CreateInBoundsGEP(builder_.getInt8Ty(),
+                                                   native_locked_cache_base_, offset),
+                        builder_.GetInsertBlock()});
+    builder_.CreateBr(resolved);
+    builder_.SetInsertPoint(next);
+  }
+  if (native_flat_vmem_view_) {
+    auto *viewType = StructType::get(context_, {pointer, builder_.getInt32Ty()});
+    auto *size = builder_.CreateLoad(builder_.getInt32Ty(),
+        builder_.CreateStructGEP(viewType, native_flat_vmem_view_, 1));
+    size->setVolatile(true);
+    Value *offset = builder_.CreateSub(address, builder_.getInt32(0x7e000000u));
+    Value *admitted = builder_.CreateAnd(
+        builder_.CreateICmpUGE(size, builder_.getInt32(span)),
+        builder_.CreateICmpULE(offset, builder_.CreateSub(size, builder_.getInt32(span))));
+    auto *direct = BasicBlock::Create(context_, "psq_resolve_flat_vmem", function_);
+    auto *next = BasicBlock::Create(context_, "psq_resolve_paged_vmem", function_);
+    builder_.CreateCondBr(admitted, direct, next);
+    builder_.SetInsertPoint(direct);
+    Value *base = builder_.CreateLoad(pointer,
+        builder_.CreateStructGEP(viewType, native_flat_vmem_view_, 0));
+    incoming.push_back({builder_.CreateInBoundsGEP(builder_.getInt8Ty(), base, offset),
+                        builder_.GetInsertBlock()});
+    builder_.CreateBr(resolved);
+    builder_.SetInsertPoint(next);
+    if (nativePagedVmemEnabled()) {
+      Value *host = pagedVmemPointer(address, span, write, miss);
+      incoming.push_back({host, builder_.GetInsertBlock()});
+      builder_.CreateBr(resolved);
+    } else {
+      builder_.CreateBr(miss);
+    }
+  } else {
+    builder_.CreateBr(miss);
+  }
+
+  builder_.SetInsertPoint(resolved);
+  PHINode *host = builder_.CreatePHI(pointer, incoming.size(), "psq.host");
+  for (auto &[value, block] : incoming)
+    host->addIncoming(value, block);
+  return host;
+}
+
 Value *FunctionEmitter::normalizeAddress(Value *address) {
   return builder_.CreateAnd(address, builder_.getInt32(~0x40000000u));
 }
