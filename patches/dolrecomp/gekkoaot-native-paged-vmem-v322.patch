+
+// Architectural state read by the paged-VM admission. A slot this function
+// never touches still holds its entry value: the native-ABI argument when
+// present, otherwise CPUState.
+Value *FunctionEmitter::pagedVmemState(DolIRStateSlot slot) {
+  if (used_[slot] && state_[slot])
+    return stateValue(slot);
+  if (native_abi_ && native_inputs_[slot])
+    return native_inputs_[slot];
+  return loadContext(slot);
+}
+
+// GEKKOAOT_NATIVE_PAGED_VMEM_V322: real VM paging used to send every 0x7e/0x7f
+// access through the external memory service (state sync, call, DTLB lookup,
+// state reload): ~3M calls/s in HPPOA/CoD. The runtime publishes exactly the
+// resident DTLB entries (frame | read | write-with-C | way) in the view and
+// withdraws them on eviction/tlbie, so a hit here is the same translation the
+// service would use. Misses, page-crossing scalars, user mode, DR=0 and a
+// changed SR7 keep the original exact service path (which fills/faults).
+Value *FunctionEmitter::pagedVmemPointer(Value *address, u32 width, bool write,
+                                         BasicBlock *miss) {
+  Type *pointer = PointerType::getUnqual(context_);
+  Type *i32 = builder_.getInt32Ty();
+  auto *viewType = StructType::get(context_, {pointer, i32, i32, pointer, pointer});
+  Value *offset = builder_.CreateSub(address, builder_.getInt32(0x7e000000u));
+  Value *pageOffset = builder_.CreateAnd(address, builder_.getInt32(0xfffu));
+  Value *candidate = builder_.CreateAnd(
+      builder_.CreateICmpULT(offset, builder_.getInt32(0x02000000u)),
+      builder_.CreateICmpULE(pageOffset, builder_.getInt32(0x1000u - width)));
+  auto *probe = BasicBlock::Create(
+      context_, write ? "store_paged_vmem_probe" : "load_paged_vmem_probe", function_);
+  builder_.CreateCondBr(candidate, probe, miss);
+
+  builder_.SetInsertPoint(probe);
+  Value *pages = builder_.CreateLoad(
+      pointer, builder_.CreateStructGEP(viewType, native_flat_vmem_view_, 3));
+  Value *index = builder_.CreateZExt(builder_.CreateLShr(offset, 12u),
+                                     builder_.getInt64Ty());
+  Value *entry = builder_.CreateLoad(i32, builder_.CreateInBoundsGEP(i32, pages, index),
+                                     "paged.vmem.entry");
+  Value *segment = builder_.CreateLoad(
+      i32, builder_.CreateStructGEP(viewType, native_flat_vmem_view_, 2));
+  Value *msr = pagedVmemState(DOLIR_STATE_MSR);
+  Value *sr7 = pagedVmemState(static_cast<DolIRStateSlot>(DOLIR_STATE_SR0 + 7));
+  Value *admitted = builder_.CreateAnd(
+      builder_.CreateICmpNE(builder_.CreateAnd(entry, builder_.getInt32(write ? 2u : 1u)),
+                            builder_.getInt32(0)),
+      builder_.CreateAnd(
+          builder_.CreateICmpEQ(builder_.CreateAnd(msr, builder_.getInt32(0x4010u)),
+                                builder_.getInt32(0x10u)),
+          builder_.CreateICmpEQ(sr7, segment)));
+  auto *hit = BasicBlock::Create(
+      context_, write ? "store_paged_vmem" : "load_paged_vmem", function_);
+  builder_.CreateCondBr(admitted, hit, miss,
+                        MDBuilder(context_).createBranchWeights(2000, 1));
+
+  builder_.SetInsertPoint(hit);
+  // Same 2-way LRU update as a runtime DTLB hit.
+  Value *mru = builder_.CreateLoad(
+      pointer, builder_.CreateStructGEP(viewType, native_flat_vmem_view_, 4));
+  Value *set = builder_.CreateZExt(
+      builder_.CreateAnd(builder_.CreateLShr(address, 12u), builder_.getInt32(0x3fu)),
+      builder_.getInt64Ty());
+  builder_.CreateStore(
+      builder_.CreateTrunc(builder_.CreateAnd(builder_.CreateLShr(entry, 2u),
+                                              builder_.getInt32(1u)),
+                           builder_.getInt8Ty()),
+      builder_.CreateInBoundsGEP(builder_.getInt8Ty(), mru, set));
+  Value *physical = builder_.CreateOr(
+      builder_.CreateAnd(entry, builder_.getInt32(0xfffff000u)), pageOffset);
+  return builder_.CreateInBoundsGEP(builder_.getInt8Ty(), ram_,
+                                    builder_.CreateZExt(physical, builder_.getInt64Ty()));
+}
