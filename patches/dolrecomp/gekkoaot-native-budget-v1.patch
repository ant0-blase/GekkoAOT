+namespace {
+u64 configuredBudget(const char* name, u64 fallback, u64 minimum, u64 maximum) {
+  const char* text = std::getenv(name);
+  if (!text || !*text)
+    return fallback;
+  char* end = nullptr;
+  errno = 0;
+  const unsigned long long value = std::strtoull(text, &end, 10);
+  if (errno || !end || *end || value < minimum || value > maximum)
+    return fallback;
+  return static_cast<u64>(value);
+}
+
+u64 recompcoreGuardCycles() {
+  static const u64 value = configuredBudget("DOLRECOMP_GUARD_CYCLES", 2048u, 256u, 1048576u);
+  return value;
+}
+
+u64 recompcoreGuardSteps() {
+  static const u64 value = configuredBudget("DOLRECOMP_GUARD_STEPS", 8192u, 2048u, 1048576u);
+  return value;
+}
