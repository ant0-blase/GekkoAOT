     fprintf(out, "    ctx->pc = address;\n");
     fprintf(out, "    if (dolrecomp_dispatch_replacement(ctx, address)) return 1;\n");
-    fprintf(out, "    if (ctx->host_call && ppc_host_call(ctx, address)) return 1;\n");
