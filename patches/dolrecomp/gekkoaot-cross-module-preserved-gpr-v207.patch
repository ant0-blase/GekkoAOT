diff --git a/src/app/pipeline.c b/src/app/pipeline.c
--- a/src/app/pipeline.c
+++ b/src/app/pipeline.c
@@ -463,6 +463,21 @@ static int append_llvm_abi_edge(DolLLVMCallEdge** edges, u32* count,
     return 1;
 }
 
+static int rel_crossmodule_live_v208_enabled(void) {
+    const char* value = getenv("DOLRECOMP_REL_RUNTIME_TRANSLATE");
+    return value && value[0] && !(value[0] == '0' && value[1] == '\0');
+}
+
+static void rel_crossmodule_live_v208_add_inputs(
+    DolLLVMFunctionRange* range, const u64* defined_before) {
+    for (u32 reg = 14u; reg < 32u; reg++) {
+        const u32 slot = (u32)DOLIR_STATE_GPR0 + reg;
+        const u64 bit = 1ull << (slot & 63u);
+        if (!(defined_before[slot >> 6u] & bit))
+            range->input_state[slot >> 6u] |= bit;
+    }
+}
+
 static int prepare_llvm_function_abis(const LoadedCodeSection* sections,
                                       u32 section_count,
                                       DolLLVMFunctionRange* ranges,
@@ -471,6 +486,8 @@ static int prepare_llvm_function_abis(const LoadedCodeSection* sections,
     DolLLVMCallEdge* edges = NULL;
     u32 edge_count = 0;
     u32 edge_capacity = 0;
+    const int rel_crossmodule_live = rel_crossmodule_live_v208_enabled();
+    u32 rel_external_edges = 0;
     for (u32 range_index = 0; range_index < range_count; range_index++) {
         const LoadedCodeSection* section = NULL;
     for (u32 s = 0; s < section_count; s++) {
@@ -527,22 +544,32 @@ static int prepare_llvm_function_abis(const LoadedCodeSection* sections,
                 for (u32 slot = 0; slot < targets; slot++) {
                     const DolLLVMFunctionRange* target = llvm_range_for(
                         ranges, range_count, term->target_addresses[slot]);
-                    if (target && target->start != ranges[range_index].start &&
-                    !append_llvm_abi_edge(&edges, &edge_count, &edge_capacity,
-                            ranges[range_index].start,
-                                          term->target_addresses[slot],
-                                          live_after, defined_before)) {
-                        dolir_module_free(&module);
-                        goto fail;
+                    if (target && target->start != ranges[range_index].start) {
+                        if (!append_llvm_abi_edge(
+                                &edges, &edge_count, &edge_capacity,
+                                ranges[range_index].start,
+                                term->target_addresses[slot],
+                                live_after, defined_before)) {
+                            dolir_module_free(&module);
+                            goto fail;
+                        }
+                    } else if (!target && rel_crossmodule_live &&
+                               term->target_addresses[slot] != 0u) {
+                        rel_crossmodule_live_v208_add_inputs(
+                            &ranges[range_index], defined_before);
+                        rel_external_edges++;
                     }
                 }
             }
             dolir_module_free(&module);
         }
+    if (rel_crossmodule_live && rel_external_edges)
+        printf("DOLRECOMP_REL_CROSSMODULE_LIVE_V208=1 external_edges=%u preserved_gpr=r14-r31 policy=undefined-before-only+native-abi-propagation\n",
+               rel_external_edges);
     if (runtime == DOLLLVM_RUNTIME_MODERNGEKKO)
         dolllvm_enable_native_services(ranges, range_count);
     if (!dolllvm_propagate_function_abis(ranges, range_count, edges,
                                          edge_count))
         goto fail;
     free(edges);
     return 1;
diff --git a/src/backend/llvm/llvm_backend.h b/src/backend/llvm/llvm_backend.h
