+bool relCrossModuleLiveV208() {
+  const char *value = std::getenv("DOLRECOMP_REL_RUNTIME_TRANSLATE");
+  return value && value[0] &&
+         !(value[0] == '0' && value[1] == '\0');
+}
+
 u32 nativeABIFlags(const DolIRFunction &function, u32 *blockers) {
   bool memory = false;
   *blockers = 0;
@@ -58,9 +65,13 @@ u32 nativeABIFlags(const DolIRFunction &function, u32 *blockers) {
     const bool computedCtrBranch =
         block.terminator.kind == DOLIR_TERM_INDIRECT &&
         (raw >> 26) == 19u && ((raw >> 1) & 0x3ffu) == 528u;
-    if (!block.cycle_cost || block.terminator.kind == DOLIR_TERM_FALLBACK ||
