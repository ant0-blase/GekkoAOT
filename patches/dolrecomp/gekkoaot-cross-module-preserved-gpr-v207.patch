+    if (!block.cycle_cost || block.terminator.kind == DOLIR_TERM_FALLBACK)
       *blockers |= DOLLLVM_ABI_BLOCK_CONTROL;
+    if (computedCtrBranch) {
+      *blockers |= DOLLLVM_ABI_BLOCK_CONTROL;
+      if (relCrossModuleLiveV208())
+        *blockers |= DOLLLVM_ABI_BLOCK_REL_COMPUTED_CTR;
+    }
     if (block.terminator.kind == DOLIR_TERM_SYSTEM_CALL)
       *blockers |= DOLLLVM_ABI_BLOCK_EXCEPTION;
     if (block.terminator.kind == DOLIR_TERM_RFI)
@@ -183,6 +194,17 @@ extern "C" bool dolllvm_analyze_function_abi(const DolIRFunction *function,
     range->semantic_output_state[word] = 0;
   }
   range->abi_flags = nativeABIFlags(*function, &range->abi_blockers);
+  if (range->abi_blockers & DOLLLVM_ABI_BLOCK_REL_COMPUTED_CTR) {
+    for (u32 reg = 14u; reg < 32u; reg++) {
+      const auto slot =
+          static_cast<DolIRStateSlot>(DOLIR_STATE_GPR0 + reg);
+      const u32 raw = static_cast<u32>(slot);
+      const u64 bit = 1ull << (raw & 63u);
+      const u32 word = raw >> 6u;
+      if (!(range->must_def_state[word] & bit))
+        range->input_state[word] |= bit;
+    }
+  }
   return true;
 }
 
diff --git a/src/backend/llvm/abi_policy.cpp b/src/backend/llvm/abi_policy.cpp
