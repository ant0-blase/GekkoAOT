@@ -1,1 +1,1 @@
     if (dispatch_lookup_mode() != DISPATCH_LOOKUP_INDEXED ||
         !emit_lookup_indexed(out, funcs))
         emit_function_lookup(out, funcs, "");
+    emit_static_hostcall_filter(out);
