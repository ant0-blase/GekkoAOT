+++ b/src/backend/c_cfg.c
@@ -1,1 +1,1 @@
 static bool instruction_is_outlinable(const PPCInst* inst) {
@@ -1,1 +1,1 @@
 }
+
+/* GekkoAOT v43: conservative Portable-C busy-wait recognition.  This is the
+ * C-backend counterpart of the LLVM poll park: only a tiny local conditional
+ * backedge containing one non-updating scalar load plus compare/bit-test
+ * operations qualifies.  Pointer walking, stores, calls, CTR loops and any
+ * other progress-producing instruction fail closed to the ordinary loop path. */
+static bool instruction_is_poll_load(const PPCInst* inst) {
+    switch (inst->op) {
+    case PPC_OP_LWZ:
+    case PPC_OP_LBZ:
+    case PPC_OP_LHZ:
+    case PPC_OP_LHA:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool instruction_is_poll_transform(const PPCInst* inst) {
+    switch (inst->op) {
+    case PPC_OP_CMPI:
+    case PPC_OP_CMPLI:
+    case PPC_OP_CMP:
+    case PPC_OP_CMPL:
+    case PPC_OP_ANDI:
+    case PPC_OP_ANDIS:
+    case PPC_OP_RLWINM:
+    case PPC_OP_EXTSB:
+    case PPC_OP_EXTSH:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool loop_is_pure_poll(const PPCInst* insts, u32 first, u32 last) {
+    if (last <= first || last - first > 7u)
+        return false;
+    const PPCInst* branch = &insts[last];
+    if (branch->op != PPC_OP_BC || branch->lk)
+        return false;
+    /* BO[2] == 1 means CTR is ignored. A counted loop is real guest work. */
+    if ((branch->bo & 0x04u) == 0u)
+        return false;
+
+    u32 loads = 0u;
+    for (u32 i = first; i < last; ++i) {
+        if (instruction_is_poll_load(&insts[i])) {
+            if (++loads != 1u)
+                return false;
+            continue;
+        }
+        if (!instruction_is_poll_transform(&insts[i]))
+            return false;
+    }
+    return loads == 1u;
+}
